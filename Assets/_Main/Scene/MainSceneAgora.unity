  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33c8cc7bf8c8e94428fa402e96f30259, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SetupGameMode
  modeOption: {fileID: 908709183738694814}
  textDescripsiGameMode: {fileID: 1814737103}
  btnPlay: {fileID: 8805215713759855952}
  gameModeStatustext: {fileID: 211295140}
  gameMode:
  - gamemode: 0
    gameModeDescription: Face Mode (Facial Recognition) This mode uses your device's
      camera to visually analyze your emotions. With face recognition technology,
      the system tracks micro-expressions on your face in real-time. Keep your composure,
      because every muscle twitch showing anger, stress, or sadness will increase
      your emotion score.
  - gamemode: 1
    gameModeDescription: Smartwatch Mode (Heart Rate) Connect your smartwatch (e.g.,
      HyperRate) for a deeper challenge. This mode directly monitors your heart rate
      (BPM) as a physiological indicator of your stress level. Every sudden spike
      in your heart rate is considered an emotional reaction, truly testing your
      ability to control your body's responses under pressure.
  - gamemode: 2
    gameModeDescription: Voice Mode (Vocal Analysis) In this mode, your voice is
      a double-edged sword. The system analyzes your vocal characteristics via the
      microphone. A higher pitch, increased speaking speed, or tremors in your voice
      will be interpreted as signs that your emotions are becoming unstable, raising
      your score.
  heartRateVisualizer: {fileID: 1003185382}
  toggleSmartWatch: {fileID: 2014333346}
  toggleFaceMode: {fileID: 575214815}
  acourntToogle: {fileID: 4917715437742671789}
