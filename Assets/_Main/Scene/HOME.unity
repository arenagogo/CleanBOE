  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Facemode is a game mode that judges players based on their facial expressions.\n\nWhen
    you enter a Facemode match, your goal is to provoke your opponent\u2019s emotions
    according to the given category. One player will be assigned as the Host and
    the other as the Guest.\n\nIf you\u2019re the Host, your task is to make your
    opponent show emotions. Observe your opponent\u2019s face \u2014 when you notice
    a change in their expression, click Scan in the app. The system will analyze
    your opponent\u2019s facial expression and assign a score based on their emotional
    intensity \u2014 the angrier they look, the higher your score.\n\nAfter the first
    round ends, roles will switch \u2014 the Host becomes the Guest, and the Guest
    becomes the Host. As the Guest, your goal is to stay calm and control your emotions
    to reduce your opponent\u2019s chances of winning."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53bd60210aca747438bc6dc6c1b9c600, type: 2}
  m_sharedMaterial: {fileID: -1903338348908255764, guid: 53bd60210aca747438bc6dc6c1b9c600, type: 2}
